{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "normalize-academic-transcript",
  "description": "Convert international tertiary transcripts into standardized ECTS/US semester credit and GPA equivalencies.",
  "parameters": {
    "type": "object",
    "properties": {
      "institution_code": {
        "type": "string"
      },
      "raw_grades": {
        "type": "string"
      },
      "curriculum_major": {
        "type": "string"
      }
    },
    "required": [
      "institution_code",
      "raw_grades"
    ]
  }
}